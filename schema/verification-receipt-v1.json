{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denchco.github.io/knowledge-base-wiki-documentation/schema/verification-receipt-v1.json",
  "title": "DenchCo verification orchestrator receipt v1",
  "description": "Explicit gate evidence consumed by the full-profile report builder. Missing gates are never inferred.",
  "type": "object",
  "required": [
    "$schema",
    "receiptVersion",
    "target",
    "profile",
    "evaluationDate",
    "startedAt",
    "completedAt",
    "environment",
    "canonicalMutation",
    "gates"
  ],
  "properties": {
    "$schema": {
      "const": "https://denchco.github.io/knowledge-base-wiki-documentation/schema/verification-receipt-v1.json"
    },
    "receiptVersion": { "const": "1.0" },
    "target": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "evaluationDate": { "$ref": "#/$defs/date" },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "required": ["runtime", "runtimeVersion", "platform", "architecture"],
      "properties": {
        "runtime": { "$ref": "#/$defs/nonEmptyString" },
        "runtimeVersion": { "$ref": "#/$defs/nonEmptyString" },
        "platform": { "$ref": "#/$defs/nonEmptyString" },
        "architecture": { "$ref": "#/$defs/nonEmptyString" },
        "ci": { "type": "boolean" },
        "tools": { "type": "object" }
      },
      "additionalProperties": false
    },
    "canonicalMutation": { "$ref": "#/$defs/canonicalMutation" },
    "gates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/gate" }
    },
    "manualChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/manualCheck" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "resultStatus": { "enum": ["pass", "fail", "not-checked"] },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "location": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    },
    "subcontrolResult": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/resultStatus" },
        "reason": { "type": "string" },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "requirementResult": {
      "type": "object",
      "required": ["requirement", "status"],
      "properties": {
        "requirement": { "type": "string", "pattern": "^DKBWS-[A-Z]+-[0-9]{3}$" },
        "status": { "$ref": "#/$defs/resultStatus" },
        "reason": { "type": "string" },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "subcontrols": {
          "type": "array",
          "items": { "$ref": "#/$defs/subcontrolResult" }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["id", "status", "evidence", "results"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "status": { "$ref": "#/$defs/resultStatus" },
        "command": { "type": "string" },
        "exitCode": { "type": "integer" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirementResult" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pass" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence": { "type": "array", "minItems": 1 },
              "results": { "type": "array", "minItems": 1 },
              "exitCode": { "const": 0 }
            },
            "required": ["exitCode"]
          }
        }
      ],
      "additionalProperties": false
    },
    "manualCheck": {
      "type": "object",
      "required": ["id", "requirement", "status", "reason", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "requirement": { "type": "string", "pattern": "^DKBWS-[A-Z]+-[0-9]{3}$" },
        "status": { "$ref": "#/$defs/resultStatus" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "subcontrols": {
          "type": "array",
          "items": { "$ref": "#/$defs/subcontrolResult" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pass" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "canonicalMutation": {
      "type": "object",
      "required": ["status", "changedPaths"],
      "properties": {
        "status": { "$ref": "#/$defs/resultStatus" },
        "changedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "method": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["requirement", "mode", "status", "readOnly", "git", "jujutsu"],
      "properties": {
        "requirement": { "const": "DKBWS-PROV-001" },
        "mode": { "enum": ["maintainer", "distribution"] },
        "status": { "enum": ["pass", "not-checked"] },
        "readOnly": { "const": true },
        "git": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "const": "pass" } },
          "additionalProperties": true
        },
        "jujutsu": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["pass", "not-checked"] } },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
