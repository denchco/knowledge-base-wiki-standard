{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denchco.github.io/knowledge-base-wiki-standard/schema/manifest-v1.json",
  "title": "DenchCo Knowledge Base Wiki Standard manifest",
  "description": "Portable, repository-relative declaration of the selected DenchCo standard, OKF bundle, roles, capabilities, and explicit deviations.",
  "type": "object",
  "required": ["schema", "standard", "profile", "okf_version", "roles", "capabilities", "deviations"],
  "properties": {
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "type": "object",
      "required": ["name", "version", "source"],
      "properties": {
        "name": {
          "const": "DenchCo Knowledge Base Wiki Standard"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "okf_version": {
      "const": "0.2"
    },
    "roles": {
      "type": "object",
      "required": ["okf_bundle"],
      "minProperties": 1,
      "properties": {
        "okf_bundle": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/capabilityValue"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "status", "reason"],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^DKBWS-[A-Z]+-[0-9]{3}$"
          },
          "status": {
            "enum": ["pending", "waived", "deviates", "not-applicable"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expires": {
            "$ref": "#/$defs/date"
          },
          "reviewed_at": {
            "$ref": "#/$defs/date"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": { "const": "waived" }
              },
              "required": ["status"]
            },
            "then": {
              "required": ["authority"],
              "anyOf": [
                { "required": ["expires"] },
                { "required": ["reviewed_at"] }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
          { "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)" }
        ]
      }
    },
    "capabilityValue": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string" },
        { "type": "number" },
        { "type": "object" },
        { "type": "array" },
        { "type": "null" }
      ]
    }
  }
}
