{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denchco.github.io/knowledge-base-wiki-documentation/schema/wiki-appearance-v1.json",
  "title": "Optional Wiki appearance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accent", "appearance", "width"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "minLength": 7, "maxLength": 7 },
    "appearance": { "enum": ["light", "dark"] },
    "width": { "enum": ["standard", "wide"] }
  }
}
