schema: "https://denchco.github.io/knowledge-base-wiki-documentation/schema/manifest-v1.json"
standard:
  name: "DenchCo Knowledge Base Wiki Standard"
  version: "{{STANDARD_VERSION}}"
  source: "https://github.com/denchco/knowledge-base-wiki-standard"
  revision: "{{STANDARD_REVISION}}"
profile: "{{PROFILE}}"
okf_version: "0.2"
roles:
  okf_bundle: "knowledge"
  source_register: "docs/sources.md"
  evidence_matrix: "docs/evidence-matrix.md"
  validation_queue: "docs/validation-queue.md"
  research_log: "docs/log.md"
  human_wiki: "docs/index.md"
{{GOVERNING_QUESTION_ROLE_BLOCK_OR_EMPTY}}
  llm_wiki: "docs/llm-wiki/index.md"
  design_contract: "DESIGN.md"
capabilities:
  evidence_governance: true
  human_wiki: true
{{GOVERNING_QUESTION_CAPABILITY_BLOCK_OR_FALSE}}
  llm_wiki: true
  human_wiki_url: "{{WIKI_URL}}"
  local_service: "{{LOCAL_SERVICE_ADAPTER}}"
  deployment: "{{DEPLOYMENT_ADAPTER_OR_NONE}}"
deviations: {{CONDITIONAL_DEVIATIONS_OR_EMPTY}}
